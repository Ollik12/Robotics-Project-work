<?xml version="1.0" ?>
<sdf version="1.6">
    <world name="workcell">

        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <gravity>0 0 -9.8</gravity>

        <!-- ================================================================ -->
        <!-- SYSTEM PLUGINS                                                    -->
        <!-- ================================================================ -->
        <plugin filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-contact-system"
                name="gz::sim::systems::Contact"/>
        <!-- Camera and lidar rendering -->
        <plugin filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
        </plugin>
        <!-- IMU -->
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu"/>

        <!-- Ground -->
        <model name="ground">
            <static>true</static>

            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>20 20</size>
                    </plane>
                </geometry>
                </collision>

                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>20 20</size>
                    </plane>
                </geometry>
                </visual>
            </link>
        </model>
    
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.4 0.2 -1.0</direction>
        </light>

        <!-- A simple white box model where Franka is placed-->
        <model name="box">
            <static>true</static>
            <pose>0 0 0.5 0 0 0</pose>
            <link name="link">
                <pose>0 0 0 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.39 0.27 1</ambient>
                        <diffuse>0.5 0.39 0.27 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Small green box for pick and place test task -->
        <model name="pick_place_box">
            <pose>0.1 0.35 1.02 0 0 0</pose>
            <link name="link">
                <pose>0 0 0 0 0 0</pose>
                <inertial>
                    <mass>0.01</mass>
                </inertial>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.035 0.035 0.035</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.035 0.035 0.035</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0 1 0 1</ambient>
                        <diffuse>0 1 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="blue_place_surface">
            <static>true</static>
            <pose>0.2 -0.3 1.0025 0 0 0</pose>
            <link name="link">
                <pose>0 0 0 0 0 0</pose>
                <inertial>
                    <mass>0.01</mass>
                </inertial>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.15 0.15 0.005</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.15 0.15 0.005</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0 0.2 1 1</ambient>
                        <diffuse>0 0.2 1 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Camera to capture the workcell from the side -->
        <model name='side_camera'>
            <pose>-0.6 0.7 1.9 -0.1 0.7 -0.83</pose>
            <static>true</static>
            <link name='side_camera_link'>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.1 0.1 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.1 0.1 0.8 1</ambient>
                        <diffuse>0.1 0.1 0.8 1</diffuse>
                    </material>
                </visual>
                <sensor name='camera_sensor' type='camera'>
                    <topic>/side_camera/image</topic>
                    <always_on>true</always_on>
                    <update_rate>30</update_rate>
                    <visualize>true</visualize>
                    <camera>
                        <horizontal_fov>1.047</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.05</near>
                            <far>10.0</far>
                        </clip>
                    </camera>
                </sensor>
            </link>
        </model>

    </world>
</sdf>